# Copy this file to .env and fill in every value. See README.md, "Setup".
# Never commit .env.

# Google Cloud > APIs & Services > Credentials > your "Web application" OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://www.last.fm/api/account/create (listed later at https://www.last.fm/api/accounts)
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Listen only on this computer (adapter-node defaults to 0.0.0.0, i.e. your whole network)
HOST=127.0.0.1

# Optional: directory for the local SQLite database (default: data)
# DATA_DIR=data
